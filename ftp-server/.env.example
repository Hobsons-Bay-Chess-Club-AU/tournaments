# HBCC Vega Tournament Server - Authenticated Arbiter Keypairs
# Comma-separated list of allowed usernames and corresponding passwords.
# E.g. user1 logs in with pass1, user2 logs in with pass2, etc.

FTP_USERNAME=arbiter1,arbiter2,arbiter3
FTP_PASSWORD=password_arbiter1,password_arbiter2,password_arbiter3

# Supabase Cloud Database Sync
# Used to automatically upsert tournament metadata & data.json into Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_TABLE=tournaments
