{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "HBCC FTP Server",
  "version": "0.1.8",
  "identifier": "com.hobsonsbaychess.ftpserver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HBCC Tournament FTP Server",
        "width": 1050,
        "height": 720,
        "minWidth": 840,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/vega-parser"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4QTVBM0I5QTBEQjM5NjEKUldSaE9kdWd1YU9sT0w5TkhrQ0x6MnJmTldQcG85aXgwbkZTbU9TaFRxS2lRMU1UbzR0RkVJMlkK",
      "endpoints": [
        "https://github.com/Hobsons-Bay-Chess-Club-AU/tournaments/releases/latest/download/latest.json"
      ]
    }
  }
}
